# ---------- Backend ----------
# Comma-separated key pool (>= 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
# Default LiteLLM model for every key
LLM_MODEL=gemini/gemini-2.5-flash
# Optional: one model per key (same order), e.g. to spread the pool across models
LLM_MODELS=
# SQLite file inside the Docker volume
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend URL)
ALLOWED_ORIGINS=http://localhost:3000
# Enables the X-Simulate-Failure header on POST /chat
ENABLE_FAILURE_SIMULATION=true
# LiteLLM cache backend: local (in-memory) or disk (persists under CACHE_DIR)
CACHE_TYPE=disk
CACHE_DIR=/data/llm_cache
CACHE_TTL_SECONDS=86400
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
# Number of past messages sent to the model as context
HISTORY_LIMIT=40
# true = offline mock replies via LiteLLM mock_response (no real API calls)
MOCK_LLM=false

# ---------- Frontend ----------
# URL the browser uses to reach the backend (docker compose)
PUBLIC_API_URL=http://localhost:8000
# Static hosts (Vercel/Netlify) read this at build time instead
VITE_API_URL=http://localhost:8000
